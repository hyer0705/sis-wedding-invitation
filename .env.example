# 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋되지 않는다(.gitignore).
# 배포에 쓰이는 값은 Vercel 프로젝트 환경변수에도 같은 이름으로 등록해야 한다.

# Kakao Developers 앱의 JavaScript 키 (지도 임베드 + 카톡 공유 버튼)
VITE_KAKAO_JS_KEY=


# ── RSVP 수신 (Supabase) ───────────────────────────────────────────────────
# 브라우저가 Supabase 를 직접 호출한다. 서버는 없고, 접근 통제는 전부 RLS 정책
# (supabase/schema.sql)이 한다 — 그래서 publishable 키는 노출되어도 되는 값이고,
# R2 시크릿과 달리 VITE_ 접두사가 **맞다**.
#
# 대시보드 Settings → API Keys 에서 가져온다. Project ID(project ref)가 아니라
# 그것을 서브도메인으로 갖는 전체 URL 이어야 한다.
#
#   VITE_SUPABASE_URL=https://<project-ref>.supabase.co
#   VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#
# secret 키(sb_secret_)는 여기에도, Vercel 에도, 어디에도 넣지 않는다. 이 접두사가
# 붙은 값은 청첩장 JS 에 그대로 박혀 RLS 를 통째로 우회할 수 있게 된다.
# 레거시 anon 키(eyJ... JWT)는 2026년 말 지원이 끝난다 — 예식이 2027년 1월이라
# 쓰지 않는다. 두 값 모두 `npm run verify` 가 형식까지 확인한다.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=


# ── 이미지 호스팅 (Cloudflare R2) ──────────────────────────────────────────
# 사진은 리포가 아니라 R2 버킷에 둔다(SIS-28).

# 사진을 받아올 공개 베이스 URL. 끝 슬래시는 있어도 없어도 된다.
# 비워 두면 로컬 /images 로 폴백하므로 R2 없이도 개발은 된다.
# R2 커스텀 도메인을 쓴다: https://img.hb-hj-wedding.com
# (r2.dev 개발 URL 은 rate limit 이 있어 프로덕션에 쓰지 않는다)
VITE_IMAGE_BASE_URL=

# 아래 넷은 `npm run upload:images` 전용이다. VITE_ 접두사를 붙이면 안 된다 —
# 그 접두사가 붙은 값은 Vite 가 클라이언트 번들에 그대로 넣어, 시크릿 키가
# 청첩장 JS 에 박히고 누구나 버킷에 쓸 수 있게 된다.
# Vercel 환경변수에도 등록할 필요가 없다 (업로드는 로컬에서만 한다).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=


# ── 고객 개인정보 ───────────────────────────────────────────────────────────
# 리포에 남기지 않기로 한 값들이다. 비워 두면 src/invite.ts 의 mock 으로
# 폴백하므로 .env 없이도 개발은 된다. 실값 누락은 `npm run verify` 가 잡는다.

# 혼주 성함 — 표기 순서와 고인(故) 여부는 코드(INVITE.*.parents)에서 정한다.
#
# 신랑 어머니(VITE_GROOM_MOTHER)는 없다. 표기하지 않기로 고객이 확정해
# (2026-08-11) INVITE.groom.parents 에서 항목을 뺐다. 여기에 값을 적어도
# 화면에는 나오지 않는다 — 다시 표기하려면 코드부터 되돌려야 한다.
VITE_GROOM_FATHER=
VITE_BRIDE_FATHER=
VITE_BRIDE_MOTHER=

# 계좌 — `역할|은행|계좌번호|예금주` 를 세미콜론(;)으로 이어 붙인다.
# 적은 순서가 그대로 화면 순서가 된다. 항목이 4개가 아니면 그 계좌는 무시된다.
#
#   VITE_ACCOUNTS_GROOM=신랑|국민은행|000000-00-000000|홍길동;신랑 아버지|신한은행|111-111-111111|홍아무
#
# 예시의 계좌번호는 모든 자리가 같은 숫자다. 진짜 형식으로 적으면 검토 게이트가
# 개인정보로 보고 커밋을 막는다.
#
# 신부측은 아버지가 고인이라 계좌를 두지 않는다.
VITE_ACCOUNTS_GROOM=
VITE_ACCOUNTS_BRIDE=
